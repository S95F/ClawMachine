{
  "listen_addr": ":8080",
  "tls_cert_file": "",
  "tls_key_file": "",
  "session_secret": "",
  "session_ttl_hours": 12,
  "cookie_secure": true,
  "username": "admin",
  "password_hash": "",
  "repos_dir": "/srv/apps",
  "public_base_url": "https://updater.example.com",
  "github_token": "",
  "log_path": "/var/log/servergitupdater/updates.log",
  "max_log_rows": 500,
  "apps": [
    {
      "id": "auto",
      "name": "clawmachine",
      "repo_path": "/srv/apps/clawmachine",
      "clone_url": "https://github.com/S95F/ClawMachine.git",
      "branch": "main",
      "remote": "origin",
      "post_update_command": "",
      "post_update_args": [],
      "git_env": [],
      "auto_update_enabled": false,
      "auto_update_minutes": 15,
      "auto_build_enabled": true,
      "build_command": "go",
      "build_args": ["build", "-o", "{repo_path}/{name}", "./..."],
      "app_port": 8090,
      "port_flag": "-port",
      "service_manage_enabled": true,
      "service_name": "clawmachine",
      "service_scope": "system",
      "service_description": "Claw Machine — Three.js demo (Go static server)",
      "service_exec_start": "/srv/apps/clawmachine/clawmachine",
      "service_exec_args": ["-port", "{port}"],
      "service_working_dir": "/srv/apps/clawmachine",
      "service_user": "www-data",
      "service_env": ["GOFLAGS=-trimpath"],
      "service_restart": "on-failure",
      "caddy_enabled": true,
      "caddy_auto_apply": true,
      "caddy_mode": "proxy",
      "caddy_domain": "clawmachine.example.com",
      "caddy_upstream": "127.0.0.1:{port}",
      "caddy_root": "",
      "caddy_browse": false,
      "caddy_try_files": "",
      "caddy_extra": "encode zstd gzip",
      "caddy_snippet_dir": "/etc/caddy/sites.d",
      "caddy_snippet_name": "clawmachine",
      "caddy_reload_command": ["systemctl", "reload", "caddy"],
      "import_from_repo_file": true,
      "repo_file_path": ".servergitupdater.json",
      "webhook_enabled": true,
      "webhook_secret": "",
      "webhook_branch_only": true,
      "webhook_auto_register": false,
      "webhook_remote_id": 0
    }
  ]
}
